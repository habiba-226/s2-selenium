<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="IoT Automation Suite">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Regression Tests" preserve-order="true">
        <classes>
            <class name="com.dxc.iot.tests.SignUpTests"/>
            <class name="com.dxc.iot.tests.LoginTests"/>
            <class name="com.dxc.iot.tests.ProfileTests"/>
            <class name="com.dxc.iot.tests.SettingsTests"/>
            <class name="com.dxc.iot.tests.HomeTests"/>
            <class name="com.dxc.iot.tests.SessionTests"/>
        </classes>
    </test>

    <test name="Sprint 3 Tests" preserve-order="true">
        <classes>
            <class name="com.dxc.iot.tests.EntryPointTests"/>
            <class name="com.dxc.iot.tests.NotificationTests"/>
            <class name="com.dxc.iot.tests.TrafficDashboardTests"/>
        </classes>
    </test>

</suite>